rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin gate. To rotate the admin OR add a second admin, switch to a
    // custom claim: `admin.auth().setCustomUserClaims(uid, { admin: true })`
    // and change isAdmin() to `request.auth.token.admin == true`.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'letsvibe.mumbai@gmail.com';
    }

    // ----- screens -----
    // Public read; admin write.
    match /screens/{screenId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----- addon items & packages -----
    // Public read of any doc (booking form needs to load them; we filter by
    // `active` client-side). Admin write only.
    match /addonItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /addonPackages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----- bookings -----
    // Admin-only direct access. The customer-facing confirmation/status pages
    // are server-rendered (Next.js admin SDK), so no client GET is required —
    // a public `allow get` would leak PII (name, phone, email, payment
    // screenshot URL) to anyone who obtains a booking ID via email, browser
    // history, or shared screenshot.
    //
    // Public CREATE is permitted only for the tightly-shaped guest-checkout
    // path: pending/online/zero-paid bookings with no Razorpay payment id, an
    // exact key set, and per-field type/format/range constraints to prevent
    // tampering or injection of admin-only fields.
    match /bookings/{bookingId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending'
        && request.resource.data.source == 'online'
        && request.resource.data.amountPaid == 0
        && !('razorpayPaymentId' in request.resource.data)
        && request.resource.data.keys().hasAll([
          'screenId', 'date', 'startTime', 'endTime', 'duration',
          'customerName', 'customerPhone', 'guestCount',
          'amount', 'amountPaid', 'status', 'source'
        ])
        // Type + range checks to harden against malformed / hostile writes.
        // Server actions remain the canonical create path; rules are a
        // belt-and-braces backstop for direct client-SDK writes.
        && request.resource.data.screenId in ['beach', 'grass', 'forest']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startTime is string
        && request.resource.data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.endTime is string
        && request.resource.data.endTime.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.duration in [1, 2, 3]
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.guestCount is int
        && request.resource.data.guestCount >= 1
        && request.resource.data.guestCount <= 50
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000
      );
    }

    // ----- expenses -----
    // Admin only.
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // ----- customers (CRM, keyed by phone) -----
    // Created/updated server-side via the Admin SDK during booking creation
    // (which bypasses these rules). No direct client access.
    match /customers/{phone} {
      allow read, write: if isAdmin();
    }

    // ----- settings (membership config, etc.) -----
    // Public read so the booking/account UI can show current terms; admin write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----- memberships/{uid} -----
    // A user may read their own record and create their own `pending` request.
    // Confirmation, the discounted-booking decrement, and revocation all happen
    // server-side via the Admin SDK (which bypasses these rules).
    match /memberships/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.remainingDiscountedBookings == 0
      );
      allow update, delete: if isAdmin();
    }

    // Default deny: any collection not explicitly granted above is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
